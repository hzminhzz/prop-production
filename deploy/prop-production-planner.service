# prop-production Planner SHADOW worker (no receipts source is admitted yet).
[Unit]
Description=prop-production Planner worker (SHADOW, synthetic receipts only)
Requires=prop-production-broker.service
After=prop-production-broker.service

[Service]
Type=simple
User=prop-planner
Group=prop
UMask=0077
ExecStart=/opt/prop-production/venv/bin/python -m prop_production.driver planner /var/lib/prop-production
Restart=always
RestartSec=5
TimeoutStopSec=10

# Hardening: Planner cannot hold broker credentials and has no network.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/prop-production

[Install]
WantedBy=multi-user.target
