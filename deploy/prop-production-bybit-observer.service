# Independent Bybit DEMO account observer. Strictly read-only, no Guardian order authority.
[Unit]
Description=prop-production Bybit Demo read-only account observer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prop-bybit
Group=prop
UMask=0077
EnvironmentFile=/etc/prop-production/bybit.env
Environment=PROP_BYBIT_STATE=/var/lib/prop-production/bybit
Environment=PYTHONPATH=/opt/prop-production/current/connector
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/prop-production/current/venv/bin/python -m prop_production.bybit_observer
Restart=always
RestartSec=7
TimeoutStopSec=15

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/prop-production
MemoryMax=512M
TasksMax=64
RestrictNamespaces=yes
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
